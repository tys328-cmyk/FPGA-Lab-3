`timescale 1ns / 1ps

module tb_top;

reg [9:0] sw;

wire [6:0] seg;
wire [3:0] an;
wire led;

top DUT (
    .sw(sw),
    .seg(seg),
    .an(an),
    .led(led)
);

initial begin

    // A = 3, B = 2, Cin = 0, Sel = 0
    sw = 10'b0000100011;
    #20;

    // A = 3, B = 2, Cin = 0, Sel = 1
    sw = 10'b1000100011;
    #20;

    // A = 4, B = 3, Cin = 0, Sel = 1
    sw = 10'b1000110100;
    #20;

    // A = 5, B = 4, Cin = 0, Sel = 1
    sw = 10'b1001000101;
    #20;

    $finish;

end

endmodule

